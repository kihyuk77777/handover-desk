# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소에 올리지 않는다.
# 설명은 반드시 따로 한 줄에 쓴다(값 뒤에 붙여 쓰면 값의 일부로 읽힌다).

# --- 화면 ---
# 화면 로그인 비밀번호. 비워 두면 로그인할 수 없다.
APP_PASSWORD=
# 쿠키 서명용 임의 문자열. 예: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
# 알림에 넣을 화면 주소. 예: https://desk.example.com
HD_BASE_URL=
HD_TITLE=Handover Desk
# 내 PC에서 시험할 때만 1로 둔다. 외부에 여는 서버에서는 쓰지 않는다.
# HD_NO_AUTH=1

# --- 메일 입력 ---
# eml: inbox 폴더의 .eml 파일 / gmail: 지메일(읽기 전용)
HD_MAIL_SOURCE=eml
# HD_EML_DIR=inbox
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# python -m scripts.gmail_auth 로 발급
GMAIL_REFRESH_TOKEN=

# --- 모델 (Ollama 호환 API) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b-mlx

# --- 텔레그램 ---
# 비워 두면 보내지 않고 알림 기록에만 남긴다.
TELEGRAM_BOT_TOKEN=
# 받는 사람의 대화방 번호. config/staff.yaml 의 코드를 대문자로 쓴다(TG_CHAT_<코드>).
TG_CHAT_PM_KIM=
TG_CHAT_ENG_PARK=
TG_CHAT_ENG_CHOI=
