[Unit]
Description=Handover Desk worker
After=network-online.target desk-tunnel.service

[Service]
User=APP_USER
WorkingDirectory=/opt/handover-desk
ExecStart=/opt/handover-desk/.venv/bin/python -m app.worker
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
